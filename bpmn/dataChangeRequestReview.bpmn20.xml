<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:activiti="http://activiti.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.reltio.com/bpmn">

    <process id="dataChangeRequestReview"
             name="DCR Review (Contact triple-step)"
             isExecutable="true">

        <dataObject id="manualStart" name="manualStart" itemSubjectRef="xsd:boolean">
            <extensionElements><activiti:value>false</activiti:value></extensionElements>
        </dataObject>
        <dataObject id="deleted" name="deleted" itemSubjectRef="xsd:boolean">
            <extensionElements><activiti:value>false</activiti:value></extensionElements>
        </dataObject>

        <startEvent id="start" name="Start">
            <extensionElements>
                <activiti:executionListener event="start"
                    class="com.reltio.workflow.activiti.service.DCRHasChangesListener"/>
            </extensionElements>
        </startEvent>

        <serviceTask id="resolveEntityType" name="Resolve contact-change context"
                     activiti:class="com.company.workflow.contactdcr.ResolveContactChangeContext"/>

        <exclusiveGateway id="entityTypeGate" name="Route by scope" default="flowStandardReview"/>

        <!-- Individual / Organization email or address: 3 sequential approvals -->
        <userTask id="contactApiReview" name="Contact Change – API Approval"
                  activiti:dueDate="P2D"
                  activiti:candidateGroups="ROLE_API">
            <extensionElements>
                <activiti:formProperty id="decision" name="Decision" type="enum" default="Approve" required="true">
                    <activiti:value id="Approve" name="Approve"/>
                    <activiti:value id="Reject" name="Reject" commentRequired="true"/>
                </activiti:formProperty>
                <activiti:formProperty id="accessTypes" name="AccessTypes" type="string"
                    default="ACCEPT_CHANGE_REQUEST" writable="false"/>
                <activiti:formProperty id="validator" name="Validator" type="string"
                    default="com.reltio.workflow.core.task.validator.DataChangeRequestValidator" writable="false"/>
                <activiti:formProperty id="notificationOnAssignmentEnabled" name="NotificationOnAssignmentEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:formProperty id="notificationOnCompletionEnabled" name="NotificationOnCompletionEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.TaskStartEventListener"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.DCRTypeTaskListener"/>
                <activiti:taskListener event="assignment"
                    class="com.reltio.workflow.activiti.service.TaskAssignmentEventListener"/>
                <activiti:taskListener event="complete"
                    class="com.company.workflow.contactdcr.ContactChangeApprovalAuditListener"/>
            </extensionElements>
        </userTask>

        <exclusiveGateway id="contactApiGateway" name="API decision" default="flowContactApiReject"/>

        <userTask id="contactAdminReview1" name="Contact Change – Admin Approval (1)"
                  activiti:dueDate="P2D"
                  activiti:candidateGroups="ROLE_ADMIN">
            <extensionElements>
                <activiti:formProperty id="decision" name="Decision" type="enum" default="Approve" required="true">
                    <activiti:value id="Approve" name="Approve"/>
                    <activiti:value id="Reject" name="Reject" commentRequired="true"/>
                </activiti:formProperty>
                <activiti:formProperty id="accessTypes" name="AccessTypes" type="string"
                    default="ACCEPT_CHANGE_REQUEST" writable="false"/>
                <activiti:formProperty id="validator" name="Validator" type="string"
                    default="com.reltio.workflow.core.task.validator.DataChangeRequestValidator" writable="false"/>
                <activiti:formProperty id="notificationOnAssignmentEnabled" name="NotificationOnAssignmentEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:formProperty id="notificationOnCompletionEnabled" name="NotificationOnCompletionEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.TaskStartEventListener"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.DCRTypeTaskListener"/>
                <activiti:taskListener event="assignment"
                    class="com.reltio.workflow.activiti.service.TaskAssignmentEventListener"/>
                <activiti:taskListener event="complete"
                    class="com.company.workflow.contactdcr.ContactChangeApprovalAuditListener"/>
            </extensionElements>
        </userTask>

        <exclusiveGateway id="contactAdminGateway1" name="Admin decision (1)" default="flowContactAdmin1Reject"/>

        <userTask id="contactAdminReview2" name="Contact Change – Admin Approval (2)"
                  activiti:dueDate="P2D"
                  activiti:candidateGroups="ROLE_ADMIN">
            <extensionElements>
                <activiti:formProperty id="decision" name="Decision" type="enum" default="Approve" required="true">
                    <activiti:value id="Approve" name="Approve"/>
                    <activiti:value id="Reject" name="Reject" commentRequired="true"/>
                </activiti:formProperty>
                <activiti:formProperty id="accessTypes" name="AccessTypes" type="string"
                    default="ACCEPT_CHANGE_REQUEST" writable="false"/>
                <activiti:formProperty id="validator" name="Validator" type="string"
                    default="com.reltio.workflow.core.task.validator.DataChangeRequestValidator" writable="false"/>
                <activiti:formProperty id="notificationOnAssignmentEnabled" name="NotificationOnAssignmentEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:formProperty id="notificationOnCompletionEnabled" name="NotificationOnCompletionEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.TaskStartEventListener"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.DCRTypeTaskListener"/>
                <activiti:taskListener event="assignment"
                    class="com.reltio.workflow.activiti.service.TaskAssignmentEventListener"/>
                <activiti:taskListener event="complete"
                    class="com.company.workflow.contactdcr.ContactChangeApprovalAuditListener"/>
            </extensionElements>
        </userTask>

        <exclusiveGateway id="contactAdminGateway2" name="Admin decision (2)" default="flowContactAdmin2Reject"/>

        <serviceTask id="contactApplyDcr" name="Apply contact DCR"
                     activiti:class="com.company.workflow.contactdcr.ContactChangeApply"/>
        <serviceTask id="contactRejectDcr" name="Reject contact DCR"
                     activiti:class="com.company.workflow.contactdcr.ContactChangeReject"/>

        <!-- Employee: step 1 -->
        <userTask id="employeeFirstReview" name="Employee Change – First Approval"
                  activiti:dueDate="P2D"
                  activiti:candidateGroups="ROLE_REVIEWER">
            <extensionElements>
                <activiti:formProperty id="decision" name="Decision" type="enum" default="Approve" required="true">
                    <activiti:value id="Approve" name="Approve"/>
                    <activiti:value id="Reject" name="Reject" commentRequired="true"/>
                </activiti:formProperty>
                <activiti:formProperty id="accessTypes" name="AccessTypes" type="string"
                    default="ACCEPT_CHANGE_REQUEST" writable="false"/>
                <activiti:formProperty id="validator" name="Validator" type="string"
                    default="com.reltio.workflow.core.task.validator.DataChangeRequestValidator" writable="false"/>
                <activiti:formProperty id="notificationOnAssignmentEnabled" name="NotificationOnAssignmentEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:formProperty id="notificationOnCompletionEnabled" name="NotificationOnCompletionEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.TaskStartEventListener"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.DCRTypeTaskListener"/>
                <activiti:taskListener event="assignment"
                    class="com.reltio.workflow.activiti.service.TaskAssignmentEventListener"/>
            </extensionElements>
        </userTask>

        <exclusiveGateway id="employeeGateway1" name="First decision" default="flowEmp1Reject"/>

        <userTask id="employeeSecondReview" name="Employee Change – Second Approval"
                  activiti:dueDate="P2D"
                  activiti:candidateGroups="ROLE_ADMIN">
            <extensionElements>
                <activiti:formProperty id="decision" name="Decision" type="enum" default="Approve" required="true">
                    <activiti:value id="Approve" name="Approve"/>
                    <activiti:value id="Reject" name="Reject" commentRequired="true"/>
                </activiti:formProperty>
                <activiti:formProperty id="accessTypes" name="AccessTypes" type="string"
                    default="ACCEPT_CHANGE_REQUEST" writable="false"/>
                <activiti:formProperty id="validator" name="Validator" type="string"
                    default="com.reltio.workflow.core.task.validator.DataChangeRequestValidator" writable="false"/>
                <activiti:formProperty id="notificationOnAssignmentEnabled" name="NotificationOnAssignmentEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:formProperty id="notificationOnCompletionEnabled" name="NotificationOnCompletionEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.TaskStartEventListener"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.DCRTypeTaskListener"/>
                <activiti:taskListener event="assignment"
                    class="com.reltio.workflow.activiti.service.TaskAssignmentEventListener"/>
            </extensionElements>
        </userTask>

        <exclusiveGateway id="employeeGateway2" name="Second decision" default="flowEmp2Reject"/>

        <userTask id="standardDcrReview" name="Data Change Review"
                  activiti:dueDate="P2D"
                  activiti:candidateGroups="ROLE_REVIEWER">
            <extensionElements>
                <activiti:formProperty id="decision" name="Decision" type="enum" default="Approve" required="true">
                    <activiti:value id="Approve" name="Approve"/>
                    <activiti:value id="Reject" name="Reject" commentRequired="true"/>
                </activiti:formProperty>
                <activiti:formProperty id="accessTypes" name="AccessTypes" type="string"
                    default="ACCEPT_CHANGE_REQUEST" writable="false"/>
                <activiti:formProperty id="validator" name="Validator" type="string"
                    default="com.reltio.workflow.core.task.validator.DataChangeRequestValidator" writable="false"/>
                <activiti:formProperty id="notificationOnAssignmentEnabled" name="NotificationOnAssignmentEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:formProperty id="notificationOnCompletionEnabled" name="NotificationOnCompletionEnabled"
                    type="boolean" default="true" writable="false"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.TaskStartEventListener"/>
                <activiti:taskListener event="create"
                    class="com.reltio.workflow.activiti.service.DCRTypeTaskListener"/>
                <activiti:taskListener event="assignment"
                    class="com.reltio.workflow.activiti.service.TaskAssignmentEventListener"/>
            </extensionElements>
        </userTask>

        <exclusiveGateway id="standardGateway" name="Standard decision" default="flowStdReject"/>

        <serviceTask id="applyDcr" name="Apply DCR"
                     activiti:class="com.reltio.workflow.activiti.service.ChangeRequestApply"/>
        <serviceTask id="rejectDcr" name="Reject DCR"
                     activiti:class="com.reltio.workflow.activiti.service.ChangeRequestReject"/>

        <endEvent id="endApproved" name="Approved"/>
        <endEvent id="endRejected" name="Rejected"/>

        <sequenceFlow id="flowStartResolve" sourceRef="start" targetRef="resolveEntityType"/>
        <sequenceFlow id="flowResolveGate" sourceRef="resolveEntityType" targetRef="entityTypeGate"/>

        <sequenceFlow id="flowContactTriple" sourceRef="entityTypeGate" targetRef="contactApiReview">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${contactChangeTripleReview == true}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowEmployeeBranch" sourceRef="entityTypeGate" targetRef="employeeFirstReview">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${entityType == 'configuration/entityTypes/Employee'}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowStandardReview" sourceRef="entityTypeGate" targetRef="standardDcrReview"/>

        <sequenceFlow id="flowContactApiToGw" sourceRef="contactApiReview" targetRef="contactApiGateway"/>
        <sequenceFlow id="flowContactApiApprove" sourceRef="contactApiGateway" targetRef="contactAdminReview1">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision=='Approve'}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowContactApiReject" sourceRef="contactApiGateway" targetRef="contactRejectDcr"/>

        <sequenceFlow id="flowContactAdmin1ToGw" sourceRef="contactAdminReview1" targetRef="contactAdminGateway1"/>
        <sequenceFlow id="flowContactAdmin1Approve" sourceRef="contactAdminGateway1" targetRef="contactAdminReview2">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision=='Approve'}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowContactAdmin1Reject" sourceRef="contactAdminGateway1" targetRef="contactRejectDcr"/>

        <sequenceFlow id="flowContactAdmin2ToGw" sourceRef="contactAdminReview2" targetRef="contactAdminGateway2"/>
        <sequenceFlow id="flowContactAdmin2Approve" sourceRef="contactAdminGateway2" targetRef="contactApplyDcr">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision=='Approve'}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowContactAdmin2Reject" sourceRef="contactAdminGateway2" targetRef="contactRejectDcr"/>

        <sequenceFlow id="flowContactApplyEnd" sourceRef="contactApplyDcr" targetRef="endApproved"/>
        <sequenceFlow id="flowContactRejectEnd" sourceRef="contactRejectDcr" targetRef="endRejected"/>

        <sequenceFlow id="flowEmp1ToGw" sourceRef="employeeFirstReview" targetRef="employeeGateway1"/>
        <sequenceFlow id="flowEmp1Approve" sourceRef="employeeGateway1" targetRef="employeeSecondReview">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision=='Approve'}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowEmp1Reject" sourceRef="employeeGateway1" targetRef="rejectDcr"/>

        <sequenceFlow id="flowEmp2ToGw" sourceRef="employeeSecondReview" targetRef="employeeGateway2"/>
        <sequenceFlow id="flowEmp2Approve" sourceRef="employeeGateway2" targetRef="applyDcr">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision=='Approve'}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowEmp2Reject" sourceRef="employeeGateway2" targetRef="rejectDcr"/>

        <sequenceFlow id="flowStdToGw" sourceRef="standardDcrReview" targetRef="standardGateway"/>
        <sequenceFlow id="flowStdApprove" sourceRef="standardGateway" targetRef="applyDcr">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision=='Approve'}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowStdReject" sourceRef="standardGateway" targetRef="rejectDcr"/>

        <sequenceFlow id="flowApplyEnd" sourceRef="applyDcr" targetRef="endApproved"/>
        <sequenceFlow id="flowRejectEnd" sourceRef="rejectDcr" targetRef="endRejected"/>

    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_dataChangeRequestReview">
        <bpmndi:BPMNPlane id="BPMNPlane_dataChangeRequestReview" bpmnElement="dataChangeRequestReview">

            <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
                <omgdc:Bounds x="60" y="220" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_resolveEntityType" bpmnElement="resolveEntityType">
                <omgdc:Bounds x="140" y="198" width="140" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_entityTypeGate" bpmnElement="entityTypeGate" isMarkerVisible="true">
                <omgdc:Bounds x="330" y="218" width="40" height="40"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="shape_contactApiReview" bpmnElement="contactApiReview">
                <omgdc:Bounds x="430" y="40" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_contactApiGateway" bpmnElement="contactApiGateway" isMarkerVisible="true">
                <omgdc:Bounds x="620" y="60" width="40" height="40"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_contactAdminReview1" bpmnElement="contactAdminReview1">
                <omgdc:Bounds x="710" y="40" width="160" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_contactAdminGateway1" bpmnElement="contactAdminGateway1" isMarkerVisible="true">
                <omgdc:Bounds x="910" y="60" width="40" height="40"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_contactAdminReview2" bpmnElement="contactAdminReview2">
                <omgdc:Bounds x="1000" y="40" width="160" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_contactAdminGateway2" bpmnElement="contactAdminGateway2" isMarkerVisible="true">
                <omgdc:Bounds x="1210" y="60" width="40" height="40"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_contactApplyDcr" bpmnElement="contactApplyDcr">
                <omgdc:Bounds x="1290" y="198" width="110" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_contactRejectDcr" bpmnElement="contactRejectDcr">
                <omgdc:Bounds x="850" y="320" width="110" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="shape_employeeFirstReview" bpmnElement="employeeFirstReview">
                <omgdc:Bounds x="430" y="140" width="140" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_employeeGateway1" bpmnElement="employeeGateway1" isMarkerVisible="true">
                <omgdc:Bounds x="620" y="160" width="40" height="40"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_employeeSecondReview" bpmnElement="employeeSecondReview">
                <omgdc:Bounds x="710" y="140" width="140" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_employeeGateway2" bpmnElement="employeeGateway2" isMarkerVisible="true">
                <omgdc:Bounds x="910" y="160" width="40" height="40"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="shape_standardDcrReview" bpmnElement="standardDcrReview">
                <omgdc:Bounds x="430" y="340" width="120" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_standardGateway" bpmnElement="standardGateway" isMarkerVisible="true">
                <omgdc:Bounds x="600" y="360" width="40" height="40"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="shape_applyDcr" bpmnElement="applyDcr">
                <omgdc:Bounds x="1080" y="360" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_rejectDcr" bpmnElement="rejectDcr">
                <omgdc:Bounds x="700" y="500" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_endApproved" bpmnElement="endApproved">
                <omgdc:Bounds x="1450" y="220" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="shape_endRejected" bpmnElement="endRejected">
                <omgdc:Bounds x="1000" y="522" width="36" height="36"/>
            </bpmndi:BPMNShape>

        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>